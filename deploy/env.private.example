# 개인 서버 배포용 백엔드 환경변수 (private-deploy 브랜치 전용)
# 서버에서: cp deploy/env.private.example backend/.env  후 빈 값 채우기
# backend/.env 는 커밋하지 않는다(.gitignore).
#
# 공개 주소: https://flc.tailf0d4a.ts.net  (Tailscale Funnel → nginx 127.0.0.1:8090 → 앱 127.0.0.1:8000)

ENV=prod

# --- DB (compose 가 읽는다) ---
# openssl rand -hex 24  (URL 에 들어가므로 hex 권장). 최초 DB 볼륨 생성 때만 적용된다.
POSTGRES_PASSWORD=
AUTO_CREATE_TABLES=false

# --- 인증 ---
# openssl rand -hex 32  (32바이트 미만이면 기동 거부)
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
WEB_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 출처·프록시 ---
CORS_ALLOW_ORIGINS=https://flc.tailf0d4a.ts.net
FORCE_HTTPS=true
# 앱 앞의 프록시 수: Funnel → nginx = 2. Funnel 은 클라이언트가 보낸 X-Forwarded-For 를 버리고
# 실제 IP 하나만 넘기므로(확인함) 오른쪽에서 두 번째 값이 실제 접속자 IP 다.
TRUSTED_PROXY_HOPS=2
WEB_CONCURRENCY=1
TZ=Asia/Seoul
LOG_LEVEL=INFO

# --- 데모 끄기 (운영) ---
SEED_DEMO_DATA=false
ALLOW_DEMO_FALLBACK=false

# --- AI: 개인 배포는 쓰지 않는다 ---
# 사진 분석은 503, 코치·조언은 규칙형 폴백. 가짜 식단·해시 벡터는 만들지 않는다.
ALLOW_PROD_WITHOUT_AI=true
GEMINI_API_KEY=
RECOGNIZER=gemini
COACH_LLM=gemini
EMBEDDER=gemini
AI_GLOBAL_CALLS_PER_DAY=0

# --- 첨부: 호스트 볼륨(/srv/oncare/data → /data)에 저장 ---
ATTACHMENT_STORAGE=local
ALLOW_PROD_LOCAL_ATTACHMENTS=true

# --- 카카오 ---
# REST API 키(헬스장 검색, 서버 전용)
KAKAO_REST_API_KEY=
PLACES_PROVIDER=auto
# 숫자 앱 ID(카카오 로그인 토큰 검증). 비우면 카카오 로그인 거부.
KAKAO_APP_ID=
# 비우면 해당 로그인 거부
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# --- 메일: 개인 배포는 쓰지 않는다 ---
# 가입 이메일 인증을 끈다(프론트도 SIGNUP_EMAIL_CODE=false 로 빌드). 메일이 없으므로
# 비밀번호 재설정 메일도 보내지 않는다(요청하면 503) — 카카오 로그인 또는 관리자 처리.
ALLOW_PROD_WITHOUT_MAIL=true
SIGNUP_EMAIL_VERIFICATION=false
MAIL_PROVIDER=auto

# --- 기타 ---
SENTRY_DSN=
GYM_BENEFITS_ENABLED=false
EXPOSE_API_DOCS=false
SECURITY_HEADERS=true
RATE_LIMIT_ENABLED=true
